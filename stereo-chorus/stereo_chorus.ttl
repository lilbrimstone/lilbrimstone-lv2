@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix pprop: <http://lv2plug.in/ns/ext/port-props#> .
@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .

<https://github.com/lilbrimstone/stereo_chorus>
    a lv2:Plugin , lv2:UtilityPlugin ;
    doap:name "LilBrimstone Stereo Chorus" ;
    
    # --- OUTPUTS (0, 1, 2) ---
    lv2:port [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "out_l" ;
        lv2:name "Out L"
    ] ,
    [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "out_r" ;
        lv2:name "Out R"
    ] ,
    [
        a lv2:OutputPort , atom:AtomPort ;
        lv2:index 2 ;
        lv2:symbol "midi_out" ;
        lv2:name "MIDI Out" ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent
    ] ,
    
    # --- INPUTS (3, 4, 5) ---
    [
        a lv2:InputPort , lv2:AudioPort ;
        lv2:index 3 ;
        lv2:symbol "in_l" ;
        lv2:name "In L"
    ] ,
    [
        a lv2:InputPort , lv2:AudioPort ;
        lv2:index 4 ;
        lv2:symbol "in_r" ;
        lv2:name "In R"
    ] ,
    [
        a lv2:InputPort , atom:AtomPort ;
        lv2:index 5 ;
        lv2:symbol "midi_in" ;
        lv2:name "MIDI In" ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent
    ] ,
    
    # --- CONTROLS (6+) ---
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "rate" ;
        lv2:name "Rate" ;
        lv2:default 0.5 ;
        lv2:minimum 0.1 ;
        lv2:maximum 10.0
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "depth" ;
        lv2:name "Depth" ;
        lv2:default 2.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 20.0
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "feedback" ;
        lv2:name "Feedback" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 0.95
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "mix" ;
        lv2:name "Mix" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "center" ;
        lv2:name "Center" ;
        lv2:default 3.0 ;
        lv2:minimum 1.0 ;
        lv2:maximum 100.0 ;
        lv2:portProperty pprop:logarithmic
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "hpf_cutoff" ;
        lv2:name "HPF Cutoff" ;
        lv2:default 40.0 ;
        lv2:minimum 20.0 ;
        lv2:maximum 500.0 ;
        lv2:portProperty pprop:logarithmic
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "voices" ;
        lv2:name "Voices" ;
        lv2:default 2.0 ;
        lv2:minimum 1.0 ;
        lv2:maximum 8.0 ;
        lv2:portProperty lv2:integer
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 13 ;
        lv2:symbol "spread" ;
        lv2:name "Spread" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 14 ;
        lv2:symbol "width" ;
        lv2:name "Width" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0
    ] .
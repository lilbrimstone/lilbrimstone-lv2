@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix time:  <http://lv2plug.in/ns/ext/time#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .

<https://github.com/lilbrimstone/juno-arp>
    a lv2:Plugin ;
    doap:name "LilBrimstone Juno Arp" ;
    doap:license <http://opensource.org/licenses/isc> ;
    lv2:requiredFeature urid:map ;
    lv2:optionalFeature lv2:hardRTCapable ;

    lv2:port [
        a lv2:InputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent, time:Position ;
        lv2:index 0 ;
        lv2:symbol "midi_in" ;
        lv2:name "MIDI In" ;
    ] ,

    [
        a lv2:OutputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 1 ;
        lv2:symbol "midi_out" ;
        lv2:name "MIDI Out" ;
    ] ,

    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 2 ;
        lv2:symbol "rate" ;
        lv2:name "Rate" ;
        lv2:default 4 ;
        lv2:minimum 0 ;
        lv2:maximum 9 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "1/2";    rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "1/4";    rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "1/8";    rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "1/8T";   rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "1/16";   rdf:value 4 ] ;
        lv2:scalePoint [ rdfs:label "1/16T";  rdf:value 5 ] ;
        lv2:scalePoint [ rdfs:label "1/32";   rdf:value 6 ] ;
        lv2:scalePoint [ rdfs:label "1/32T";  rdf:value 7 ] ;
        lv2:scalePoint [ rdfs:label "1/64";   rdf:value 8 ] ;
        lv2:scalePoint [ rdfs:label "1/64T";  rdf:value 9 ] ;
    ] ,

    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "range" ;
        lv2:name "Range (Oct)" ;
        lv2:default 1 ;
        lv2:minimum 1 ;
        lv2:maximum 3 ;
        lv2:portProperty lv2:integer ;
    ] ,

    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "mode" ;
        lv2:name "Mode" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 3 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Up";         rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Down";       rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Up & Down";  rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "Random";     rdf:value 3 ] ;
    ] ,

    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "gate" ;
        lv2:name "Gate %" ;
        lv2:default 80 ;
        lv2:minimum 5 ;
        lv2:maximum 200 ;
        lv2:portProperty lv2:integer ;
    ] ,

    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "hold" ;
        lv2:name "Hold" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
    ] ,

    [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 7 ;
        lv2:symbol "in_l" ;
        lv2:name "In L" ;
    ] ,

    [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 8 ;
        lv2:symbol "in_r" ;
        lv2:name "In R" ;
    ] ,

    [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 9 ;
        lv2:symbol "out_l" ;
        lv2:name "Out L" ;
    ] ,

    [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 10 ;
        lv2:symbol "out_r" ;
        lv2:name "Out R" ;
    ] .
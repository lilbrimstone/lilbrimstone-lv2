@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

<https://github.com/lilbrimstone/braids>
    a lv2:Plugin , lv2:InstrumentPlugin ;
    doap:name "LilBrimstone Braids" ;
    doap:license <http://opensource.org/licenses/mit> ;
    doap:maintainer [ foaf:name "LilBrimstone" ] ;
    lv2:requiredFeature urid:map ;
    
    lv2:port [
        a lv2:InputPort , atom:AtomPort ;
        lv2:index 0 ;
        lv2:symbol "midi_in" ;
        lv2:name "MIDI In" ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent
    ] , [
        a lv2:OutputPort , atom:AtomPort ;
        lv2:index 1 ;
        lv2:symbol "midi_out" ;
        lv2:name "MIDI Out" ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent
    ] , [
        a lv2:InputPort , lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "in_l" ;
        lv2:name "In L"
    ] , [
        a lv2:InputPort , lv2:AudioPort ;
        lv2:index 3 ;
        lv2:symbol "in_r" ;
        lv2:name "In R"
    ] , [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 4 ;
        lv2:symbol "out_l" ;
        lv2:name "Out L"
    ] , [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 5 ;
        lv2:symbol "out_r" ;
        lv2:name "Out R"
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "shape" ;
        lv2:name "Model" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 47 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        
        lv2:scalePoint [ rdfs:label "CSAW" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "MORPH" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "SAW SQUARE" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "SINE TRIANGLE" ; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "BUZZ" ; rdf:value 4 ] ;
        lv2:scalePoint [ rdfs:label "SQUARE SUB" ; rdf:value 5 ] ;
        lv2:scalePoint [ rdfs:label "SAW SUB" ; rdf:value 6 ] ;
        lv2:scalePoint [ rdfs:label "SQUARE SYNC" ; rdf:value 7 ] ;
        lv2:scalePoint [ rdfs:label "SAW SYNC" ; rdf:value 8 ] ;
        lv2:scalePoint [ rdfs:label "TRIPLE SAW" ; rdf:value 9 ] ;
        lv2:scalePoint [ rdfs:label "TRIPLE SQUARE" ; rdf:value 10 ] ;
        lv2:scalePoint [ rdfs:label "TRIPLE TRIANGLE" ; rdf:value 11 ] ;
        lv2:scalePoint [ rdfs:label "TRIPLE SINE" ; rdf:value 12 ] ;
        lv2:scalePoint [ rdfs:label "TRIPLE RING" ; rdf:value 13 ] ;
        lv2:scalePoint [ rdfs:label "SAW SWARM" ; rdf:value 14 ] ;
        lv2:scalePoint [ rdfs:label "SAW COMB" ; rdf:value 15 ] ;
        lv2:scalePoint [ rdfs:label "TOY" ; rdf:value 16 ] ;
        lv2:scalePoint [ rdfs:label "DIGITAL LP" ; rdf:value 17 ] ;
        lv2:scalePoint [ rdfs:label "DIGITAL PK" ; rdf:value 18 ] ;
        lv2:scalePoint [ rdfs:label "DIGITAL BP" ; rdf:value 19 ] ;
        lv2:scalePoint [ rdfs:label "DIGITAL HP" ; rdf:value 20 ] ;
        lv2:scalePoint [ rdfs:label "VOSIM" ; rdf:value 21 ] ;
        lv2:scalePoint [ rdfs:label "VOWEL" ; rdf:value 22 ] ;
        lv2:scalePoint [ rdfs:label "VOWEL FOF" ; rdf:value 23 ] ;
        lv2:scalePoint [ rdfs:label "HARMONICS" ; rdf:value 24 ] ;
        lv2:scalePoint [ rdfs:label "FM" ; rdf:value 25 ] ;
        lv2:scalePoint [ rdfs:label "FEEDBACK FM" ; rdf:value 26 ] ;
        lv2:scalePoint [ rdfs:label "CHAOTIC FM" ; rdf:value 27 ] ;
        lv2:scalePoint [ rdfs:label "PLUCKED" ; rdf:value 28 ] ;
        lv2:scalePoint [ rdfs:label "BOWED" ; rdf:value 29 ] ;
        lv2:scalePoint [ rdfs:label "BLOWN" ; rdf:value 30 ] ;
        lv2:scalePoint [ rdfs:label "FLUTED" ; rdf:value 31 ] ;
        lv2:scalePoint [ rdfs:label "STRUCK BELL" ; rdf:value 32 ] ;
        lv2:scalePoint [ rdfs:label "STRUCK DRUM" ; rdf:value 33 ] ;
        lv2:scalePoint [ rdfs:label "KICK" ; rdf:value 34 ] ;
        lv2:scalePoint [ rdfs:label "CYMBAL" ; rdf:value 35 ] ;
        lv2:scalePoint [ rdfs:label "SNARE" ; rdf:value 36 ] ;
        lv2:scalePoint [ rdfs:label "WAVETABLES" ; rdf:value 37 ] ;
        lv2:scalePoint [ rdfs:label "WAVE MAP" ; rdf:value 38 ] ;
        lv2:scalePoint [ rdfs:label "WAVE LINE" ; rdf:value 39 ] ;
        lv2:scalePoint [ rdfs:label "WAVE PARA" ; rdf:value 40 ] ;
        lv2:scalePoint [ rdfs:label "FILTERED NOISE" ; rdf:value 41 ] ;
        lv2:scalePoint [ rdfs:label "TWIN PEAKS" ; rdf:value 42 ] ;
        lv2:scalePoint [ rdfs:label "CLOCKED NOISE" ; rdf:value 43 ] ;
        lv2:scalePoint [ rdfs:label "GRANULAR CLOUD" ; rdf:value 44 ] ;
        lv2:scalePoint [ rdfs:label "GRANULAR RIVER" ; rdf:value 45 ] ;
        lv2:scalePoint [ rdfs:label "PARTICLE NOISE" ; rdf:value 46 ] ;
        lv2:scalePoint [ rdfs:label "QUESTION MARK" ; rdf:value 47 ]
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "timbre" ;
        lv2:name "Timbre" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "color" ;
        lv2:name "Color" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0
    ] .
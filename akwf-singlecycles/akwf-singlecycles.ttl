        lv2:scalePoint [ rdfs:label "oscchip" ; rdf:value 51 ] ;
        lv2:scalePoint [ rdfs:label "overtone" ; rdf:value 52 ] ;
        lv2:scalePoint [ rdfs:label "piano" ; rdf:value 53 ] ;
        lv2:scalePoint [ rdfs:label "pluckalgo" ; rdf:value 54 ] ;
        lv2:scalePoint [ rdfs:label "raw" ; rdf:value 55 ] ;
        lv2:scalePoint [ rdfs:label "sinharm" ; rdf:value 56 ] ;
        lv2:scalePoint [ rdfs:label "snippets" ; rdf:value 57 ] ;
        lv2:scalePoint [ rdfs:label "stereo" ; rdf:value 58 ] ;
        lv2:scalePoint [ rdfs:label "stringbox" ; rdf:value 59 ] ;
        lv2:scalePoint [ rdfs:label "symetric" ; rdf:value 60 ] ;
        lv2:scalePoint [ rdfs:label "theremin" ; rdf:value 61 ] ;
        lv2:scalePoint [ rdfs:label "vgame" ; rdf:value 62 ] ;
        lv2:scalePoint [ rdfs:label "vgamebasic" ; rdf:value 63 ] ;
        lv2:scalePoint [ rdfs:label "violin" ; rdf:value 64 ] ;
    ] , [
        a lv2:InputPort ;
        a lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "wave_a" ;
        lv2:name "Wave Num A" ;
        lv2:portProperty lv2:integer ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 199 ;
    ] , [
        a lv2:InputPort ;
        a lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "coarse_a" ;
        lv2:name "Coarse A" ;
        lv2:portProperty lv2:integer ;
        lv2:default 0 ;
        lv2:minimum -24 ;
        lv2:maximum 24 ;
    ] , [
        a lv2:InputPort ;
        a lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "fine_a" ;
        lv2:name "Fine A" ;
        lv2:default 0.0 ;
        lv2:minimum -100.0 ;
        lv2:maximum 100.0 ;
    ] , [
        a lv2:InputPort ;

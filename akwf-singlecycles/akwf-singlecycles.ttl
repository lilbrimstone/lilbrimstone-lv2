        lv2:scalePoint [ rdfs:label "0008" ; rdf:value 7 ] ;
        lv2:scalePoint [ rdfs:label "0009" ; rdf:value 8 ] ;
        lv2:scalePoint [ rdfs:label "0010" ; rdf:value 9 ] ;
        lv2:scalePoint [ rdfs:label "0011" ; rdf:value 10 ] ;

        lv2:scalePoint [ rdfs:label "bw_blended" ; rdf:value 24 ] ;
        lv2:scalePoint [ rdfs:label "bw_perfectwave" ; rdf:value 25 ] ;
        lv2:scalePoint [ rdfs:label "bw_saw" ; rdf:value 26 ] ;
        lv2:scalePoint [ rdfs:label "bw_sawbright" ; rdf:value 27 ] ;
        lv2:scalePoint [ rdfs:label "bw_sawgap" ; rdf:value 28 ] ;

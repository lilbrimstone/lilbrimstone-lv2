        lv2:index 9 ;
        lv2:symbol "wave_b" ;
        lv2:name "Wave Num B" ;
        lv2:portProperty lv2:integer ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 199 ;
    ] , [
        a lv2:InputPort ;
        a lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "coarse_b" ;
        lv2:name "Coarse B" ;
        lv2:portProperty lv2:integer ;
        lv2:default 0 ;
        lv2:minimum -24 ;
        lv2:maximum 24 ;
    ] , [
        a lv2:InputPort ;

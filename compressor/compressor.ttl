@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

<https://github.com/lilbrimstone/compressor>
    a lv2:Plugin , lv2:DynamicsPlugin ;
    doap:name "LilBrimstone Compressor" ;
    lv2:requiredFeature urid:map ;
    
    # 0: Input L
    lv2:port [
        a lv2:InputPort , lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "in_l" ;
        lv2:name "In L"
    ] ,
    # 1: Input R
    [
        a lv2:InputPort , lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "in_r" ;
        lv2:name "In R"
    ] ,
    # 2: Output L
    [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "out_l" ;
        lv2:name "Out L"
    ] ,
    # 3: Output R
    [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 3 ;
        lv2:symbol "out_r" ;
        lv2:name "Out R"
    ] ,
    # 4: Threshold (dB)
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "threshold" ;
        lv2:name "Threshold" ;
        lv2:default -12.0 ;
        lv2:minimum -60.0 ;
        lv2:maximum 0.0 ;
        units:unit units:db
    ] ,
    # 5: Ratio
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "ratio" ;
        lv2:name "Ratio" ;
        lv2:default 4.0 ;
        lv2:minimum 1.0 ;
        lv2:maximum 20.0
    ] ,
    # 6: Knee (dB)
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "knee" ;
        lv2:name "Knee" ;
        lv2:default 3.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 12.0 ;
        units:unit units:db
    ] ,
    # 7: Attack (ms)
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "attack" ;
        lv2:name "Attack" ;
        lv2:default 5.0 ;
        lv2:minimum 0.1 ;
        lv2:maximum 100.0 ;
        units:unit units:ms ;
        lv2:portProperty pprops:logarithmic
    ] ,
    # 8: Release (ms)
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "release" ;
        lv2:name "Release" ;
        lv2:default 100.0 ;
        lv2:minimum 10.0 ;
        lv2:maximum 1000.0 ;
        units:unit units:ms ;
        lv2:portProperty pprops:logarithmic
    ] ,
    # 9: Makeup Gain (dB)
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "makeup" ;
        lv2:name "Makeup" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 48.0 ;
        units:unit units:db
    ] ,
    # 10: Mix (Parallel Compression)
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "mix" ;
        lv2:name "Mix" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0
    ] ,
    # 11: Sidechain LPF (Hz)
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "sc_lpf" ;
        lv2:name "SC LPF" ;
        lv2:default 500.0 ;
        lv2:minimum 20.0 ;
        lv2:maximum 500.0 ;
        units:unit units:hz ;
        lv2:portProperty pprops:logarithmic
    ] ,
    # 12: Stereo Link (%)
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "link" ;
        lv2:name "Link" ;
        lv2:default 100.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc
    ] ,
    # 13: Trigger Source (Audio/MIDI)
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 13 ;
        lv2:symbol "trigger" ;
        lv2:name "Trigger Source" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Internal Audio"; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "MIDI Note";      rdf:value 1 ]
    ] ,
    # 14: MIDI In
    [
        a lv2:InputPort , atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 14 ;
        lv2:symbol "midi_in" ;
        lv2:name "MIDI In"
    ] ,
    # 15: MIDI Channel
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 15 ;
        lv2:symbol "midi_ch" ;
        lv2:name "MIDI Channel" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 16 ;
        lv2:portProperty lv2:integer ;
        lv2:scalePoint [ rdfs:label "Omni"; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Ch 16"; rdf:value 16 ]
    ] .
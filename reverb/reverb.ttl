@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix pprop: <http://lv2plug.in/ns/ext/port-props#> .

<https://github.com/lilbrimstone/reverb>
    a lv2:Plugin ;
    a lv2:ReverbPlugin ;
    doap:name "LilBrimstone Reverb" ;
    doap:license <http://opensource.org/licenses/MIT> ;
    lv2:requiredFeature urid:map ;
    lv2:optionalFeature lv2:hardRTCapable ;

    lv2:port [
        a atom:AtomPort , lv2:InputPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 0 ;
        lv2:symbol "midi_in" ;
        lv2:name "MIDI In" ;
    ] , [
        a atom:AtomPort , lv2:OutputPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 1 ;
        lv2:symbol "midi_out" ;
        lv2:name "MIDI Out" ;
    ] , [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "in_l" ;
        lv2:name "In L" ;
    ] , [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 3 ;
        lv2:symbol "in_r" ;
        lv2:name "In R" ;
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 4 ;
        lv2:symbol "out_l" ;
        lv2:name "Out L" ;
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 5 ;
        lv2:symbol "out_r" ;
        lv2:name "Out R" ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "algorithm" ;
        lv2:name "Algorithm" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 4.0 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Room" ;    rdf:value 0.0 ] ;
        lv2:scalePoint [ rdfs:label "Hall" ;    rdf:value 1.0 ] ;
        lv2:scalePoint [ rdfs:label "Plate" ;   rdf:value 2.0 ] ;
        lv2:scalePoint [ rdfs:label "Shimmer" ; rdf:value 3.0 ] ;
        lv2:scalePoint [ rdfs:label "Cloud" ;   rdf:value 4.0 ] ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "predelay" ;
        lv2:name "Pre-Delay" ;
        lv2:default 20.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 250.0 ;
        units:unit units:ms ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "decay" ;
        lv2:name "Decay" ;
        lv2:default 2.0 ;
        lv2:minimum 0.1 ;
        lv2:maximum 30.0 ;
        units:unit units:s ;
        lv2:portProperty pprop:logarithmic ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "damping" ;
        lv2:name "Damping" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "size" ;
        lv2:name "Size" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "diffusion" ;
        lv2:name "Diffusion" ;
        lv2:default 0.7 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "mod_rate" ;
        lv2:name "Mod Rate" ;
        lv2:default 0.3 ;
        lv2:minimum 0.01 ;
        lv2:maximum 5.0 ;
        units:unit units:hz ;
        lv2:portProperty pprop:logarithmic ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 13 ;
        lv2:symbol "mod_depth" ;
        lv2:name "Mod Depth" ;
        lv2:default 0.2 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 14 ;
        lv2:symbol "low_cut" ;
        lv2:name "Low Cut" ;
        lv2:default 20.0 ;
        lv2:minimum 20.0 ;
        lv2:maximum 1000.0 ;
        units:unit units:hz ;
        lv2:portProperty pprop:logarithmic ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 15 ;
        lv2:symbol "high_cut" ;
        lv2:name "High Cut" ;
        lv2:default 16000.0 ;
        lv2:minimum 1000.0 ;
        lv2:maximum 20000.0 ;
        units:unit units:hz ;
        lv2:portProperty pprop:logarithmic ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 16 ;
        lv2:symbol "width" ;
        lv2:name "Stereo Width" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 17 ;
        lv2:symbol "mix" ;
        lv2:name "Mix" ;
        lv2:default 0.35 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 18 ;
        lv2:symbol "out_gain" ;
        lv2:name "Out Gain" ;
        lv2:default 0.0 ;
        lv2:minimum -24.0 ;
        lv2:maximum 12.0 ;
        units:unit units:db ;
    ] .
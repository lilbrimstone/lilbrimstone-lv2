@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .
@prefix time:  <http://lv2plug.in/ns/ext/time#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .

<https://github.com/lilbrimstone/tape-delay>
    a lv2:Plugin , lv2:DelayPlugin ;
    doap:name "LilBrimstone Tape Delay" ;
    lv2:requiredFeature urid:map ;
    lv2:optionalFeature lv2:hardRTCapable ;
    
    lv2:port [
        a lv2:InputPort , atom:AtomPort ;
        lv2:index 0 ;
        lv2:symbol "midi_in" ;
        lv2:name "MIDI In" ;
        atom:bufferType atom:Sequence ;
        atom:supports time:Position , midi:MidiEvent
    ] , [
        a lv2:OutputPort , atom:AtomPort ;
        lv2:index 1 ;
        lv2:symbol "midi_out" ;
        lv2:name "MIDI Out" ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent
    ] , [
        a lv2:InputPort , lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "in_l" ;
        lv2:name "In L"
    ] , [
        a lv2:InputPort , lv2:AudioPort ;
        lv2:index 3 ;
        lv2:symbol "in_r" ;
        lv2:name "In R"
    ] , [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 4 ;
        lv2:symbol "out_l" ;
        lv2:name "Out L"
    ] , [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 5 ;
        lv2:symbol "out_r" ;
        lv2:name "Out R"
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "stereo_mode" ;
        lv2:name "Stereo Mode" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 3 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Stereo" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Ping Pong" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Mono" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "Cross" ; rdf:value 3 ]
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "delay_time" ;
        lv2:name "Delay Time" ;
        lv2:default 3 ;
        lv2:minimum 0 ;
        lv2:maximum 11 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "1/1" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "1/2" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "1/4D" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "1/4" ; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "1/4T" ; rdf:value 4 ] ;
        lv2:scalePoint [ rdfs:label "1/8D" ; rdf:value 5 ] ;
        lv2:scalePoint [ rdfs:label "1/8" ; rdf:value 6 ] ;
        lv2:scalePoint [ rdfs:label "1/8T" ; rdf:value 7 ] ;
        lv2:scalePoint [ rdfs:label "1/16D" ; rdf:value 8 ] ;
        lv2:scalePoint [ rdfs:label "1/16" ; rdf:value 9 ] ;
        lv2:scalePoint [ rdfs:label "1/32" ; rdf:value 10 ] ;
        lv2:scalePoint [ rdfs:label "1/64" ; rdf:value 11 ]
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "feedback" ;
        lv2:name "Feedback" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "mix" ;
        lv2:name "Mix" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "flutter_depth" ;
        lv2:name "Wow/Flutter Depth" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "flutter_rate" ;
        lv2:name "Wow/Flutter Rate" ;
        lv2:default 0.5 ;
        lv2:minimum 0.1 ;
        lv2:maximum 3.0 ;
        units:unit units:hz
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "age" ;
        lv2:name "Age" ;
        lv2:default 0.3 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 13 ;
        lv2:symbol "drive" ;
        lv2:name "Drive" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 2.0
    ] .